{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=transcription.db"
  },
  "Security": {
    "ApiKey": ""
  },
  "TranscriptionEngine": "Mock",
  "Speech": {
    "SubscriptionKey": "",
    "Region": ""
  },
  "Storage": {
    "RootPath": ""
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Chunking": {
    "ThresholdSeconds": 120,
    "ChunkLengthSeconds": 60,
    "OverlapSeconds": 5
  },
  "Worker": {
    "Concurrency": 2
  }
}
