{
  "openapi": "3.1.1",
  "info": {
    "title": "TranscriptionPipeline | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7103"
    },
    {
      "url": "http://localhost:5074"
    }
  ],
  "paths": {
    "/api/transcribe": {
      "post": {
        "tags": [
          "TranscriptionEndpoints"
        ],
        "operationId": "SubmitTranscription",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/transcribe/{id}": {
      "get": {
        "tags": [
          "TranscriptionEndpoints"
        ],
        "operationId": "GetTranscription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      }
    }
  },
  "tags": [
    {
      "name": "TranscriptionEndpoints"
    }
  ]
}